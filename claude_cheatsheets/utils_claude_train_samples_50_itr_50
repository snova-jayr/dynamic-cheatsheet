### Python Code for Identifying US GAAP Tags
```python
def identify_us_gaap_tag(context, amount):
    if "available for future share-based compensation grants" in context:
        return "ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfSharesAvailableForGrant"
    elif "weighted-average grant-date fair value of stock options" in context or "weighted-average grant-date fair value of stock options and SARs" in context:
        return "ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantsInPeriodWeightedAverageGrantDateFairValue"
    elif "number of shares issued" in context or "shares of restricted Class A common stock" in context:
        return "ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfSharesIssuedInTransaction"
    elif "vesting period" in context or "years" in context:
        return "ShareBasedCompensationArrangementByShareBasedPaymentAwardAwardVestingPeriod1"
    elif "interest expense" in context:
        return "InterestExpense"
    elif "income tax expense" in context or "income tax benefit" in context or "tax provision" in context:
        if "no" in context or "not recognized" in context:
            return "UnrecognizedTaxBenefits"
        else:
            return "IncomeTaxExpenseBenefit"
    elif "accrued liability" in context and "matter" in context:
        return "LossContingencyAccrualAtCarryingValue"
    elif "environmental liability" in context:
        return "AccrualForEnvironmentalLossContingencies"
    elif "rental expense" in context and "operating leases" in context:
        return "OperatingLeasesRentExpenseNet"
    elif "intangible assets" in context and "business combination" in context:
        if "useful life" in context:
            return "AcquiredFiniteLivedIntangibleAssetsWeightedAverageUsefulLife"
        else:
            return "BusinessCombinationRecognizedIdentifiableAssetsAcquiredAndLiabilitiesAssumedIntangibles"
    elif "Senior Notes" in context and "fair value" in context:
        return "LongTermDebtFairValue"
    elif "goodwill" in context:
        return "Goodwill"
    elif "percentage of voting interests acquired" in context or "%" in context:
        return "BusinessAcquisitionPercentageOfVotingInterestsAcquired"
    elif "aggregate consideration paid" in context:
        return "PaymentsToAcquireBusinessesGross"
    elif "net cash consideration" in context:
        return "PaymentsToAcquireBusinessesNetOfCashAcquired"
    else:
        return "Unknown"

