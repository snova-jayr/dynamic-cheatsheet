def get_us_gaap_tag(context, entity):
    # Example logic for determining the correct US GAAP tag based on context
    if "LIBOR plus" in context.lower():
        return "DebtInstrumentBasisSpreadOnVariableRate1"
    elif "federal statutory income tax rate" in context.lower():
        return "EffectiveIncomeTaxRateReconciliationAtFederalStatutoryIncomeTaxRate"
    elif "unrecognized tax benefits" in context.lower() and "of which" in context.lower():
        if "would impact the effective tax rate" in context.lower():
            return "UnrecognizedTaxBenefitsThatWouldImpactEffectiveTaxRate"
        else:
            return "UnrecognizedTaxBenefits"
    elif "net operating loss carryforwards" in context.lower():
        return "OperatingLossCarryforwards"
    elif "credit facility" in context.lower() and "amount available" in context.lower():
        return "LineOfCreditFacilityRemainingBorrowingCapacity"
    elif "aggregate investment" in context.lower():
        return "EquityMethodInvestments"
    elif "program charges" in context.lower() or "restructuring costs" in context.lower():
        if "expected" in context.lower() or "total" in context.lower():
            return "RestructuringAndRelatedCostExpectedCost1"
        else:
            return "RestructuringCharges"
    elif "sale" in context.lower() and "price per share" in context.lower():
        return "SaleOfStockPricePerShare"
    elif "share price" in context.lower():
        return "SharePrice"
    elif "amortization expense" in context.lower():
        return "AmortizationOfIntangibleAssets"
    elif "income tax benefit" in context.lower():
        return "EffectiveIncomeTaxRateContinuingOperations"
    elif "stock options" in context.lower() and "granted" in context.lower():
        return "ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantsInPeriodGross"
    elif "vesting after" in context.lower():
        return "ShareBasedCompensationArrangementByShareBasedPaymentAwardAwardVestingPeriod1"
    elif "reserved" in context.lower() and "shares for issuance" in context.lower():
        return "ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfSharesAvailableForGrant"
    # Add more conditions as needed

